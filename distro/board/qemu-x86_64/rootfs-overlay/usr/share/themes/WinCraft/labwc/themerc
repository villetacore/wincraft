# WinCraft window frame (labwc): light Windows 11 style title bars, ReactOS-clear borders.
# Keys labwc does not know (Openbox-only) are ignored.

# Title bar buttons as wide as Windows' (46 px).
window.titlebar.padding.width: 0
window.titlebar.padding.height: 0
window.button.width: 46
window.button.height: 30
window.button.spacing: 0
window.button.hover.bg.corner-radius: 0
window.active.button.close.hover.image.color: #ffffff
window.active.indicator.toggled-keybind.color: #0067c0
window.active.shadow.size: 0
window.inactive.shadow.size: 0
menu.overlap.x: 0
menu.items.padding.x: 12
menu.items.padding.y: 6
osd.border.color: #c4c4c4
osd.window-switcher.style-classic.width: 480
osd.window-switcher.style-classic.item.active.bg.color: #dbe9f8
osd.window-switcher.style-classic.item.active.border.color: #0067c0

